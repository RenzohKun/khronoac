@startuml version4
' ==========================================================================
'  Khronoac - Diagrama de clases (versión 4)
'  Generado a partir del código fuente actual (sin cambios en el código).
'
'  Convenciones:
'    <<interface>>  : clase ABC cuyos miembros son todos abstractos
'    abstract       : clase ABC con al menos un método abstracto
'    enum           : enumeraciones (str, Enum)
'    <<dataclass>>  : @dataclass(frozen=True)
'    <<exception>>  : excepciones propias del sistema
'    <<singleton>>  : clase con una sola instancia (__new__)
'  Las clases base externas (tk.Tk, ValueError, RuntimeError) se indican
'  dentro de cada clase con "hereda de ...".
'
'  Visibilidad (convención de Python):
'    -  atributo "__privado"  (se expone con @property cuando tiene getter/setter)
'    #  atributo "_protegido"
'    +  público
' ==========================================================================

top to bottom direction
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam nodesep 45
skinparam ranksep 60
skinparam packageStyle rectangle
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #34495E
  ArrowColor #34495E
}
skinparam class {
  BackgroundColor<<interface>> #E8F6EF
  BorderColor<<interface>> #1E8449
  BackgroundColor<<exception>> #FDEDEC
  BorderColor<<exception>> #C0392B
  BackgroundColor<<dataclass>> #FEF9E7
}
skinparam package {
  BackgroundColor #FBFCFC
  BorderColor #AAB7B8
}

' ==========================================================================
'  CAPA DE PRESENTACIÓN
' ==========================================================================
package "main.py" as pkg_main {
  class KhronoacApp {
    .. hereda de tk.Tk ..
    + servicioAplicacion: ServicioKhronoac
    + datos: dict
    + interfaz: KhronoacInterfaz
    + gestorDocentes: GestorDocentes
    + gestorAsignaturas: GestorAsignaturas
    + gestorEspacios: GestorEspacios
    --
    + __init__()
    + crearAccionesInterfaz(): dict
    + refrescarListas(): void
    + generarHorario(): void
    + mostrarPlanGuardado(): void
    + construirHorarioDocente(cedulaDocente: str): dict | None
    + exportarHorario(): void
  }
}

package "interfaz" as pkg_interfaz {
  class KhronoacInterfaz {
    + raiz: tk.Misc
    + acciones: dict[str, Callable]
    + dias: tuple[str]
    + hora_inicio: int
    + hora_fin: int
    + plan_horario: dict | None
    + docentes_horario: list
    + vistasDocentes: dict
    + planVistaActual: dict | None
    + tree_docentes / tree_asignaturas / tree_espacios: ttk.Treeview
    + horario_canvas: tk.Canvas
    + doc_* / asig_* / esp_*: tk.StringVar
    + minimo_var: tk.StringVar
    + paralelo_var: tk.StringVar
    # _sidebar / _contenedor / _frame_activo / _btn_sidebar
    --
    .. construcción ..
    + construir(): void
    + configurarEstilos(): void
    + construirInterfaz(): void
    + cambiarSeccion(clave_activa, frame, indicador, lbl_icono, lbl_texto, cuerpo): void
    + construirTabDocentes(): void
    + construirTabAsignaturas(): void
    + construirTabEspacios(): void
    + construirTabHorario(): void
    + diaToggle(parent, dia: str): tk.Button
    + {static} crearTree(parent, columnas): ttk.Treeview
    + {static} seccionHeader(parent, icono, titulo, subtitulo): void
    + {static} campo(parent, titulo, variable, fila, columna, ancho): ttk.Entry
    .. lectura de formularios ..
    + leerFormularioDocente(): dict
    + leerFormularioAsignatura(): dict
    + leerFormularioEspacio(): dict
    + leerMinimoParalelo(): str
    + docenteSeleccionado(): str | None
    + asignaturaSeleccionada(): str | None
    + espacioSeleccionado(): str | None
    + {static} idSeleccionado(tabla): str | None
    .. carga y limpieza ..
    + cargarDocente(docente: dict): void
    + cargarAsignatura(asignatura: dict, docente: dict | None): void
    + cargarEspacio(espacio: dict): void
    + limpiarDocente(): void
    + limpiarAsignatura(): void
    + limpiarEspacio(): void
    + actualizarListas(docentes, asignaturas, espacios): void
    .. horario ..
    + mostrarHorario(plan: dict | None, docentes: list): void
    + redibujarHorario(_evento): void
    + mostrarEstadoHorario(texto: str): void
    + {static} etiquetaDocente(docente: dict | None): str
    .. mensajes ..
    + {static} mostrarAviso(titulo, texto): void
    + {static} mostrarError(titulo, texto): void
    + {static} mostrarInformacion(titulo, texto): void
    + {static} confirmar(titulo, texto): bool
    .. eventos ..
    + eventoCambioParalelo(_evento): void
    + eventoSeleccionDocente(_evento): void
    + eventoSeleccionAsignatura(_evento): void
    + eventoSeleccionEspacio(_evento): void
  }
}

' ==========================================================================
'  CAPA DE APLICACIÓN
' ==========================================================================
package "aplicacion" as pkg_aplicacion {
  class ServicioKhronoac {
    # _persistencia: KhronoacPersistenciaDatos
    # _servicioPlanificacion: ServicioPlanificacionHorario
    + datos: dict
    --
    + <<property>> persistencia: KhronoacPersistenciaDatos
    + invalidarHorario(): void
    + obtenerHorario(): dict | None
    + generarHorario(minimo: int): dict
    + construirHorarioDocente(cedulaDocente: str): dict | None
    + exportarHorario(): Path | None
  }

  enum MotivoSolicitudHorarioInvalida {
    SIN_ASIGNATURAS
    SIN_RECURSOS
    MINIMO_INVALIDO
  }

  class SolicitudHorarioInvalida <<exception>> {
    .. hereda de ValueError ..
    + motivo: MotivoSolicitudHorarioInvalida
  }

  note bottom of ServicioKhronoac
    Función de fábrica del módulo:
    crearServicioKhronoac(directorioDatos, dias,
    horaInicio, horaFin): ServicioKhronoac
  end note
}

' ==========================================================================
'  CAPA DE GESTIÓN (catálogos)
' ==========================================================================
