    + seleccionarDesdeInterfaz(cedula: str): void
    + limpiarDesdeInterfaz(): void
    + eliminarDesdeInterfaz(): void
    + obtener(cedula: str): dict | None
    + estaAsignado(cedula: str): bool
    + guardar(formulario, cedula_anterior): EstadoGestionDocente
    + eliminar(cedula: str): EstadoGestionDocente
    # _interfazRequerida(): Any
