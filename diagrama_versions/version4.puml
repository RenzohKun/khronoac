' ==========================================================================
'  CAPA DE PLANIFICACIÓN (Adapter + Builder)
' ==========================================================================
package "planificacion" as pkg_planificacion {
  class ServicioPlanificacionHorario {
    - __dias: tuple[str]
    - __horaInicio: int
    - __horaFin: int
    - __planificador: PlanificadorHorario
    - __horarioDirector: HorarioDirector
    - __constructoresBuilder: dict[str, Callable[[], HorarioBuilder]]
    --
    + registrarBuilder(tipoHorario: str, constructor: Callable): void
    + construirHorario(tipoHorario, resultadoPlanificacion, idHorario, periodo): HorarioResultado
    + generarHorarioAcademico(registrosAsignaturas, registrosDocentes, registrosEspacios, minimo, idHorario, periodo): HorarioResultado
    + construirHorarioDocente(horarioGuardado: dict, cedulaDocente: str): dict
  }

  class PlanificadorHorario {
    - __dias: tuple[str]
    - __hora_inicio: int
    - __hora_fin: int
    - __limite_nodos: int
    --
    + generarHorario(datos: DatosPlanificacion, minimo: int): ResultadoPlanificacion
    + asignarBloques(tareas: list, espacios: dict[str, EspacioFisico]): list | None
    + tieneConflicto(sesiones: list): bool
  }

  class AsignaturaPlanificacion <<dataclass>> {
    + asignatura: Asignatura
    + docenteCedula: str
    + demandaEstimada: int
  }

  class DatosPlanificacion <<dataclass>> {
    + asignaturas: list[AsignaturaPlanificacion]
    + docentes: dict[str, Docente]
    + espacios: dict[str, EspacioFisico]
  }

  note right of DatosPlanificacion
    EntradaPlanificacion.py (adaptador de entrada):
    adaptarDatosPlanificacion(...): DatosPlanificacion
    crearDocente(registro, horaInicio, horaFin): Docente
  end note

  class ResultadoPlanificacion {
    + paralelos: list[dict]
    + sesiones: list[dict]
    + estadisticas: dict
    + franjasSinConflicto: bool
    --
    + {static} desdeDiccionario(datos: dict): ResultadoPlanificacion
    + paraDocente(cedulaDocente: str): ResultadoPlanificacion
    + aDiccionario(): dict
  }

  class HorarioDirector {
    + construir(builder: HorarioBuilder, resultadoPlanificacion, idHorario, periodo): HorarioResultado
  }

  class HorarioBuilder {
    + {static} tipoHorario: str = "Académico Presencial"
    # _id_horario: str
    # _periodo_academico: str
    # _tipo_horario: str
    # _resultadoPlanificacion: ResultadoPlanificacion | None
    --
    + reset(): HorarioBuilder
    + conIdentificador(id_horario, periodo, tipo): HorarioBuilder
    + conResultadoPlanificacion(resultadoPlanificacion): HorarioBuilder
    + construir(): HorarioResultado
  }

  class HorarioAcademicoBuilder {
    + {static} tipoHorario: str = "Académico"
  }
  class HorarioExamenesBuilder {
    + {static} tipoHorario: str = "Exámenes"
  }
  class HorarioDocenteBuilder {
    + {static} tipoHorario: str = "Horario docente"
  }

  class HorarioResultado {
    + horario: Horario
    + resultadoPlanificacion: ResultadoPlanificacion
    + paralelos: list[dict]
    + sesiones: list[dict]
    + estadisticas: dict
    + franjasSinConflicto: bool
    --
    + aDiccionario(): dict
    + __str__(): str
  }

  class DatosPlanificacionInvalidos <<exception>> {
    .. hereda de ValueError ..
  }
  class SinPlanificacionDisponible <<exception>> {
    .. hereda de RuntimeError ..
  }
}

' ==========================================================================
'  FÁBRICA DE ESPACIOS (Factory Method)
' ==========================================================================
package "fabrica_espacios" as pkg_fabrica {
  abstract class CreadorEspacio {
    + crear(datos: Mapping): EspacioFisico
    + {abstract} factoryMethod(datos: Mapping): EspacioFisico
  }
  class CreadorAula {
    + factoryMethod(datos: Mapping): EspacioFisico
  }
  class CreadorLaboratorio {
    + factoryMethod(datos: Mapping): EspacioFisico
  }

  note bottom of CreadorEspacio
    creadores.py:
    CREADORES_ESPACIO: dict[str, CreadorEspacio]
    crearEspacio(datos: Mapping): EspacioFisico
  end note
}

' ==========================================================================
'  PERSISTENCIA (Singleton)
' ==========================================================================
package "persistencia" as pkg_persistencia {
  class KhronoacPersistenciaDatos <<singleton>> {
    # {static} _instancia: KhronoacPersistenciaDatos | None
    # _inicializado: bool
    - __directorio_datos: Path
    --
    + __new__(cls): KhronoacPersistenciaDatos
    + cargarDatos(): dict
    + guardarDatos(datos: Mapping): void
    + guardarHorarioExportado(horario: Mapping, nombre_archivo: str): Path
    + leerSeccion(nombre: str, por_defecto): Any
    + guardarSeccion(nombre: str, contenido): void
  }
}

' ==========================================================================
'  MODELOS DE DOMINIO
' ==========================================================================
package "modelos" as pkg_modelos {
  abstract class Persona {
    - __cedula: str
    - __nombres: str
    - __apellidos: str
    - __correoElectronico: str
    --
    + {abstract} obtenerDatos(): str
    + {abstract} obtenerCargaAcademica(): str
  }

  class Estudiante {
    - __tipoEstudiante: str
    - __materiasInscritas: list[Asignatura]
    --
    + obtenerTipoEstudiante(): str
    + obtenerMateriasInscritas(): list[Asignatura]
    + obtenerDatos(): str
    + obtenerCargaAcademica(): str
  }

  class Docente {
    - __tituloAcademico: str
    - __disponibilidad: list[FranjaHoraria]
    --
    + registrarDisponibilidad(franja: FranjaHoraria): void
    + verificarDisponibilidad(franja: FranjaHoraria): bool
    + obtenerDatos(): str
    + obtenerCargaAcademica(): str
  }

  class AsistenteDocente {
    - __horasAsignadaAsistencia: int
    - __docenteApoya: str
    --
    + programarAsistencia(): void
    + obtenerCargaAcademica(): str
  }

  class Asignatura {
    - __nombreAsignatura: str
    - __horasRequeridas: int
    - __requiereLaboratorio: bool
    --
    + obtenerHorasTotales(): int
    + requiereLaboratorio(): bool
    + establecerRequiereLaboratorio(valor: bool): void
    + __str__(): str
  }

  class Paralelo {
    - __nombreParalelo: str
    - __cupoMaximo: int
    - __estudiantesInscritos: list[Estudiante]
    - __asignatura: Asignatura | None
    --
    + agregarEstudiante(estudiante: Estudiante): void
    + calcularDemanda(): int
  }

  class EspacioFisico {
    - __codigoAula: str
    - __capacidadMaxima: int
    - __franjasOcupadas: list[FranjaHoraria]
    --
    + {static} validarCapacidad(valor: int): void
    + verificarAforo(cantidad: int): int
    + estaDisponible(franja: FranjaHoraria): bool
    + reservarFranja(franja: FranjaHoraria): bool
    + liberarFranja(franja: FranjaHoraria): bool
    + esAptoParaAsignatura(asignatura: Asignatura): bool
  }

  class Laboratorio {
    - __equiposEspeciales: str
    - __tipoLaboratorio: str
    --
    + esAptoParaAsignatura(asignatura: Asignatura): bool
  }

  class FranjaHoraria {
    - __diaSemana: str
    - __horaInicio: time
    - __horaFin: time
    --
    + validarHoras(): void
    + verificarSolapamiento(otraFranja: IFranjaHoraria): bool
    + clonar(nuevoDia, nuevaHoraInicio, nuevaHoraFin): FranjaHoraria
  }

  class Horario {
    - __idHorario: str
    - __periodoAcademico: str
    - __tipoHorario: str
    - __franjasHorarias: list[IFranjaHoraria]
    --
    + agregarFranja(franja: IFranjaHoraria): void
    + validarConflictos(): bool
    + generarMallaHoraria(): str
  }
}

' ==========================================================================
'  ABSTRACCIONES
' ==========================================================================
package "abstraccion" as pkg_abstraccion {
  interface IFranjaHoraria <<interface>> {
    + {abstract} <<property>> diaSemana: str
    + {abstract} <<property>> horaInicio: time
    + {abstract} <<property>> horaFin: time
    + {abstract} verificarSolapamiento(otraFranja: IFranjaHoraria): bool
  }
}

' ==========================================================================
'  HERENCIA Y REALIZACIÓN
' ==========================================================================
Persona <|-- Estudiante
Persona <|-- Docente
Estudiante <|-- AsistenteDocente
EspacioFisico <|-- Laboratorio
IFranjaHoraria <|.. FranjaHoraria

CreadorEspacio <|-- CreadorAula
CreadorEspacio <|-- CreadorLaboratorio

HorarioBuilder <|-- HorarioAcademicoBuilder
HorarioBuilder <|-- HorarioExamenesBuilder
HorarioBuilder <|-- HorarioDocenteBuilder


' ==========================================================================
'  PRESENTACIÓN -> APLICACIÓN / GESTIÓN
' ==========================================================================
KhronoacApp *-- "1" KhronoacInterfaz : interfaz
KhronoacApp *-- "1" ServicioKhronoac : servicioAplicacion
KhronoacApp *-- "1" GestorDocentes
KhronoacApp *-- "1" GestorAsignaturas
KhronoacApp *-- "1" GestorEspacios

GestorDocentes --> "0..1" KhronoacInterfaz : _interfaz
GestorAsignaturas --> "0..1" KhronoacInterfaz : _interfaz
GestorEspacios --> "0..1" KhronoacInterfaz : _interfaz

' ==========================================================================
'  APLICACIÓN
' ==========================================================================
ServicioKhronoac --> "1" KhronoacPersistenciaDatos : _persistencia
ServicioKhronoac --> "1" ServicioPlanificacionHorario : _servicioPlanificacion
ServicioKhronoac ..> SolicitudHorarioInvalida : lanza
SolicitudHorarioInvalida --> "1" MotivoSolicitudHorarioInvalida : motivo

' ==========================================================================
'  GESTIÓN
' ==========================================================================
GestorDocentes --> "1" KhronoacPersistenciaDatos : _persistencia
GestorAsignaturas --> "1" KhronoacPersistenciaDatos : _persistencia
GestorEspacios --> "1" KhronoacPersistenciaDatos : _persistencia

GestorDocentes ..> EstadoGestionDocente : retorna
GestorAsignaturas ..> EstadoGestionAsignatura : retorna
GestorEspacios ..> EstadoGestionEspacio : retorna

GestorAsignaturas ..> Asignatura : valida con
GestorEspacios ..> CreadorEspacio : usa crearEspacio()
GestorEspacios ..> _EspacioInvalido : lanza

' ==========================================================================
'  PLANIFICACIÓN
' ==========================================================================
ServicioPlanificacionHorario *-- "1" PlanificadorHorario : __planificador
ServicioPlanificacionHorario *-- "1" HorarioDirector : __horarioDirector
ServicioPlanificacionHorario ..> HorarioBuilder : registra / instancia
ServicioPlanificacionHorario ..> DatosPlanificacion : adaptarDatosPlanificacion()

DatosPlanificacion *-- "0..*" AsignaturaPlanificacion : asignaturas
DatosPlanificacion o-- "0..*" Docente : docentes
DatosPlanificacion o-- "0..*" EspacioFisico : espacios
AsignaturaPlanificacion --> "1" Asignatura : asignatura
DatosPlanificacion ..> CreadorEspacio : usa crearEspacio()

PlanificadorHorario ..> DatosPlanificacion : recibe
PlanificadorHorario ..> ResultadoPlanificacion : crea
PlanificadorHorario ..> FranjaHoraria : clona prototipo
PlanificadorHorario ..> DatosPlanificacionInvalidos : lanza
PlanificadorHorario ..> SinPlanificacionDisponible : lanza

HorarioDirector ..> HorarioBuilder : dirige
HorarioBuilder o-- "0..1" ResultadoPlanificacion : _resultadoPlanificacion
HorarioBuilder ..> HorarioResultado : construye
HorarioBuilder ..> FranjaHoraria : crea
HorarioResultado *-- "1" Horario : horario
HorarioResultado --> "1" ResultadoPlanificacion : resultadoPlanificacion

' ==========================================================================
'  FÁBRICA
' ==========================================================================
CreadorEspacio ..> EspacioFisico : crea
CreadorAula ..> EspacioFisico : crea
CreadorLaboratorio ..> Laboratorio : crea

' ==========================================================================
'  DOMINIO
' ==========================================================================
Estudiante o-- "0..*" Asignatura : materiasInscritas
Docente o-- "0..*" FranjaHoraria : disponibilidad
Paralelo o-- "0..*" Estudiante : estudiantesInscritos
Paralelo --> "0..1" Asignatura : asignatura
EspacioFisico o-- "0..*" FranjaHoraria : franjasOcupadas
EspacioFisico ..> Asignatura : evalúa aptitud
Horario o-- "0..*" IFranjaHoraria : franjasHorarias

@enduml